{
  "name": "life-os",
  "version": "0.1.1",
  "private": true,
  "description": "Life OS — personal AI planning app",
  "author": {
    "name": "Demian",
    "email": "demian@oaki.studio"
  },
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "electron:compile": "tsc -p electron",
    "electron:dev": "corepack pnpm electron:compile && cross-env NEXT_DEV_URL=http://localhost:3000 electron .",
    "electron:start": "corepack pnpm build && corepack pnpm electron:compile && electron .",
    "electron:flatten": "node scripts/flatten-standalone.mjs && node scripts/verify-standalone.mjs",
    "electron:dist": "corepack pnpm build && corepack pnpm electron:flatten && corepack pnpm electron:compile && node scripts/prepare-node-runtime.mjs && node scripts/run-electron-builder.mjs --win nsis --x64 && node scripts/verify-electron-standalone.mjs \"dist/win-unpacked/resources/node-runtime/node.exe\" \"dist/win-unpacked/resources/app.asar.unpacked/.next/standalone\""
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.9.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.demian.lifeos",
    "productName": "Life OS",
    "copyright": "Copyright © 2026 Demian",
    "compression": "store",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron-dist/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json",
      "!**/*.{ts,tsx,map,md}",
      "!**/node_modules/**/test/**",
      "!**/node_modules/**/tests/**",
      "!**/.git/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": ["**/*.ps1", "**/*.reg", "node-runtime/**"]
      },
      {
        "from": "prisma/dev.db",
        "to": "seed.db"
      },
      {
        "from": "electron/tray.png",
        "to": "tray.png"
      }
    ],
    "asarUnpack": [
      "**/.prisma/**",
      "**/@prisma/**",
      "**/better-sqlite3/**",
      "**/*.node",
      ".next/standalone/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Life OS",
      "uninstallDisplayName": "Life OS"
    }
  }
}
