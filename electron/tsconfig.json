{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "../electron-dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["../electron-dist", "../node_modules"]
}
